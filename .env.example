# =================================================================
# FlowPilot AI — Root Environment Variables Configuration
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security / Authentication
JWT_SECRET=flowpilot_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration (Optional - embedded JSON DB fallback active if not provided)
MONGODB_URI=mongodb://localhost:27017/flowpilot_ai

# OpenAI GPT Integration (Required for Live AI structuring; intelligent fallback active in Demo mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# Email / Gmail Integration (Nodemailer SMTP / OAuth)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM_NAME="FlowPilot AI Automation"
EMAIL_DEFAULT_RECIPIENT=support-team@company.com

# Google Sheets Integration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_SHEET_ID=your_google_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# n8n Automation Engine Integration (Optional)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/flowpilot-inbound
N8N_API_KEY=

# Application Mode
DEMO_MODE=true
