PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

JWT_SECRET=flowpilot_jwt_secret_dev_key_2026
JWT_EXPIRES_IN=7d

# Optional - If MongoDB is not running, automatic embedded JSON store is used
MONGODB_URI=mongodb://localhost:27017/flowpilot_ai

# OpenAI GPT Configuration (Optional - intelligent NLP fallback runs if key not set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# Email / Gmail Integration
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME="FlowPilot AI Automation"
EMAIL_DEFAULT_RECIPIENT=support@company.com

# Google Sheets Integration
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# n8n Automation Webhook URL (Optional)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/flowpilot-inbound

# Set to true to simulate external integrations with realistic previews
DEMO_MODE=true
